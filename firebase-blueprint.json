{
  "entities": {
    "service": {
      "title": "Service",
      "description": "Represents a social media service for sale.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the service (e.g. 1000 Followers)" },
        "category": { "type": "string", "description": "Category (Instagram, TikTok, etc.)" },
        "price": { "type": "number", "description": "Price in TL" },
        "description": { "type": "string", "description": "Short description of the service" },
        "features": { "type": "array", "description": "List of features for this service" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "price"]
    },
    "post": {
      "title": "Blog Post",
      "description": "A blog article.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "content": { "type": "string" },
        "excerpt": { "type": "string" },
        "image": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "slug", "content"]
    },
    "order": {
      "title": "Order",
      "description": "A customer order submitted via the form.",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "instagram": { "type": "string" },
        "userId": { "type": "string", "description": "UID of the logged-in user" },
        "serviceId": { "type": "string" },
        "serviceName": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "processing", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["firstName", "lastName", "email"]
    }
  },
  "firestore": {
    "/services/{serviceId}": {
      "schema": "service",
      "description": "Store available social media services."
    },
    "/posts/{postId}": {
      "schema": "post",
      "description": "Store blog articles."
    },
    "/orders/{orderId}": {
      "schema": "order",
      "description": "Store user orders."
    }
  }
}
